<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PigResizeF.App"
             RequestedThemeVariant="Light">
  <Application.Styles>
    <FluentTheme />
    <Style Selector="Window"><Setter Property="FontFamily" Value="Noto Sans SC, Microsoft YaHei UI, PingFang SC, Arial" /></Style>
    <Style Selector="Button"><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Cursor" Value="Hand" /></Style>
  </Application.Styles>
</Application>
