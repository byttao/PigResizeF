<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PigResizeF.MainWindow"
        Width="1200" Height="960" MinWidth="1024" MinHeight="760"
        Title="图片批量裁切工具 V1.5" Background="#FFFFFF"
        FontFamily="Noto Sans SC,PingFang SC,Microsoft YaHei,sans-serif">
  <Window.Styles>
    <Style Selector="TextBlock"><Setter Property="Foreground" Value="#1C1E21" /></Style>
    <Style Selector="Button.nav"><Setter Property="Height" Value="44" /><Setter Property="HorizontalContentAlignment" Value="Left" /><Setter Property="Padding" Value="12,0" /><Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="Transparent" /><Setter Property="CornerRadius" Value="10" /><Setter Property="FontSize" Value="14" /></Style>
    <Style Selector="Button.nav.active"><Setter Property="Background" Value="#E6F0FE" /><Setter Property="BorderBrush" Value="#0064E0" /><Setter Property="Foreground" Value="#0064E0" /></Style>
    <Style Selector="Button.primary"><Setter Property="Height" Value="36" /><Setter Property="Background" Value="#0064E0" /><Setter Property="Foreground" Value="White" /><Setter Property="BorderBrush" Value="#0064E0" /><Setter Property="CornerRadius" Value="10" /></Style>
    <Style Selector="Button.teal"><Setter Property="Height" Value="36" /><Setter Property="Background" Value="#0F766E" /><Setter Property="Foreground" Value="White" /><Setter Property="BorderBrush" Value="#0F766E" /><Setter Property="CornerRadius" Value="10" /></Style>
    <Style Selector="Button.secondary"><Setter Property="Height" Value="36" /><Setter Property="Background" Value="#F1F4F8" /><Setter Property="Foreground" Value="#1C1E21" /><Setter Property="BorderBrush" Value="#E5E8ED" /><Setter Property="CornerRadius" Value="10" /></Style>
    <Style Selector="Button.danger"><Setter Property="Height" Value="36" /><Setter Property="Background" Value="#FEEBEC" /><Setter Property="Foreground" Value="#E33A4E" /><Setter Property="BorderBrush" Value="#FEEBEC" /><Setter Property="CornerRadius" Value="10" /></Style>
    <Style Selector="Border.card"><Setter Property="Background" Value="White" /><Setter Property="BorderBrush" Value="#DEE3E9" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="16" /><Setter Property="BoxShadow" Value="0 2 8 0 #0A12170F" /></Style>
    <Style Selector="Border.list-row"><Setter Property="Background" Value="White" /><Setter Property="BorderBrush" Value="#E0E5EA" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="8" /></Style>
    <Style Selector="RadioButton.choice"><Setter Property="Padding" Value="12,7" /><Setter Property="Margin" Value="0,0,0,8" /><Setter Property="BorderBrush" Value="#E0E5EA" /><Setter Property="BorderThickness" Value="1" /><Setter Property="Background" Value="White" /><Setter Property="CornerRadius" Value="10" /></Style>
    <Style Selector="RadioButton.choice:checked"><Setter Property="BorderBrush" Value="#0064E0" /><Setter Property="Background" Value="#EAF2FD" /></Style>
  </Window.Styles>
  <Grid ColumnDefinitions="240,*">
      <Border Background="#F1F4F8" Padding="16">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto">
          <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,0,0,16">
            <Border Width="40" Height="40" CornerRadius="12" Background="#0064E0"><TextBlock Text="▧" Foreground="White" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
            <StackPanel Spacing="2"><TextBlock Text="PigResizeF" FontSize="15" FontWeight="Bold" Foreground="#0A1317" /><TextBlock Text="图片批量裁切工具" FontSize="12" Foreground="#8595A4" /></StackPanel>
          </StackPanel>
          <TextBlock Grid.Row="1" Text="功能" FontSize="11" FontWeight="Bold" Foreground="#8595A4" Margin="0,0,0,10" />
          <Button Grid.Row="2" Name="ConvertNav" Classes="nav active" Click="ShowConvert"><StackPanel Orientation="Horizontal" Spacing="12"><TextBlock Text="⛶" FontSize="17" /><TextBlock Text="图片转换" /></StackPanel></Button>
          <Button Grid.Row="3" Name="CropNav" Classes="nav" Click="ShowCrop"><StackPanel Orientation="Horizontal" Spacing="12"><TextBlock Text="⌗" FontSize="17" /><TextBlock Text="图片裁切" /></StackPanel></Button>
          <Button Grid.Row="4" Name="JdNav" Classes="nav" Click="ShowJd"><StackPanel Orientation="Horizontal" Spacing="12"><TextBlock Text="▤" FontSize="17" /><TextBlock Text="京东详情页裁切" /></StackPanel></Button>
          <Border Grid.Row="6" Background="White" BorderBrush="#DEE3E9" BorderThickness="1" CornerRadius="10" Padding="12"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="V1.5" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" /><Button Grid.Column="1" Padding="0" Background="Transparent" BorderThickness="0" Foreground="#0064E0" FontSize="12" Click="CheckUpdate">检查更新</Button></Grid></Border>
        </Grid>
      </Border>
      <Grid Grid.Column="1">
        <Grid Name="ConvertView" RowDefinitions="Auto,*,Auto" Margin="24">
          <Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="4"><TextBlock Text="图片转换" FontSize="24" FontWeight="Bold" Foreground="#0A1317" /><TextBlock Text="批量等比缩放并白底补齐为统一尺寸，输出 JPG 到原图目录" FontSize="13" Foreground="#8595A4" /></StackPanel><Border Grid.Column="1" Background="#F1F4F8" CornerRadius="14" Padding="12,5"><StackPanel Orientation="Horizontal" Spacing="8"><Ellipse Width="8" Height="8" Fill="#31A24C" VerticalAlignment="Center" /><TextBlock Text="就绪" FontSize="12" FontWeight="Bold" /></StackPanel></Border></Grid>
          <Grid Grid.Row="1" ColumnDefinitions="*,224">
            <Border Classes="card" Padding="16"><Grid RowDefinitions="Auto,*"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="待转换图片" FontSize="15" FontWeight="Bold" /><Border Grid.Column="1" Background="#EAF2FD" CornerRadius="12" Padding="10,4"><TextBlock Name="ConvertCount" Text="0 张待处理" Foreground="#0064E0" FontSize="12" FontWeight="Bold" /></Border></Grid><Border Grid.Row="1" Name="ConvertDropZone" Background="#F7F9FC" BorderBrush="#DEE3E9" BorderThickness="1" CornerRadius="12" Padding="8" DragDrop.AllowDrop="True" DragDrop.DragOver="ConvertDropZone_DragOver" DragDrop.Drop="ConvertDropZone_Drop"><Grid><ScrollViewer><StackPanel Name="ConvertRows" Spacing="6" /></ScrollViewer><TextBlock Name="ConvertDropHint" Text="↥ 继续拖拽图片到此处，或点击右侧「添加文件夹」" Foreground="#8595A4" HorizontalAlignment="Center" VerticalAlignment="Center" /></Grid></Border></Grid></Border>
            <StackPanel Grid.Column="1" Spacing="12"><Border Classes="card" Padding="12"><StackPanel Spacing="8"><TextBlock Text="转换样式" FontSize="15" FontWeight="Bold" Margin="4,0,0,2" /><RadioButton Name="Size1440Square" Classes="choice" GroupName="Size" IsChecked="True"><StackPanel><TextBlock Text="1440 方图" FontWeight="Bold" Foreground="#0064E0" /><TextBlock Text="1440 × 1440" FontSize="11" Foreground="#8595A4" /></StackPanel></RadioButton><RadioButton Name="Size1440Tall" Classes="choice" GroupName="Size"><StackPanel><TextBlock Text="1440 长图" FontWeight="Bold" /><TextBlock Text="1440 × 1920" FontSize="11" Foreground="#8595A4" /></StackPanel></RadioButton><RadioButton Name="Size800Square" Classes="choice" GroupName="Size"><StackPanel><TextBlock Text="800 方图" FontWeight="Bold" /><TextBlock Text="800 × 800" FontSize="11" Foreground="#8595A4" /></StackPanel></RadioButton><RadioButton Name="SizeProduct" Classes="choice" GroupName="Size"><StackPanel><TextBlock Text="商品长图" FontWeight="Bold" /><TextBlock Text="1440 × 2160" FontSize="11" Foreground="#8595A4" /></StackPanel></RadioButton></StackPanel></Border><Border Classes="card" Padding="12"><StackPanel Spacing="8"><Button Classes="secondary" Click="AddFolder">▱  添加文件夹</Button><Button Classes="danger" Click="ClearConvert">♙  清空列表</Button><Button Classes="secondary" Click="RemoveSelectedConvert">▣  移除选中</Button><Button Classes="primary" Click="ConvertImages">▶  开始转换</Button></StackPanel></Border></StackPanel>
          </Grid>
          <Border Grid.Row="2" Classes="card" Padding="16"><Grid RowDefinitions="Auto,*"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="处理日志" FontSize="15" FontWeight="Bold" /><TextBlock Grid.Column="1" Text="最近记录" Foreground="#8595A4" FontSize="12" /></Grid><Border Grid.Row="1" Background="#F8FAFC" CornerRadius="10" Padding="12"><TextBox Name="ConvertLog" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" Background="Transparent" BorderThickness="0" FontSize="12" /></Border></Grid></Border>
        </Grid>
        <Grid Name="CropView" IsVisible="False" RowDefinitions="Auto,*,Auto" Margin="24">
          <Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="4"><TextBlock Text="图片裁切" FontSize="24" FontWeight="Bold" Foreground="#0A1317" /><TextBlock Text="自动识别单图、四宫格或九宫格拆分，支持四角乱切" FontSize="13" Foreground="#8595A4" /></StackPanel><Border Grid.Column="1" Background="#F1F4F8" CornerRadius="14" Padding="12,5"><StackPanel Orientation="Horizontal" Spacing="8"><Ellipse Width="8" Height="8" Fill="#31A24C" VerticalAlignment="Center" /><TextBlock Text="就绪" FontSize="12" FontWeight="Bold" /></StackPanel></Border></Grid>
          <Grid Grid.Row="1" RowDefinitions="*,170"><Border Classes="card" Padding="12"><Grid RowDefinitions="Auto,*"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="待裁切图片" FontSize="15" FontWeight="Bold" /><Border Grid.Column="1" Background="#EAF2FD" CornerRadius="12" Padding="10,4"><TextBlock Name="CropCount" Text="0 张待处理" Foreground="#0064E0" FontSize="12" FontWeight="Bold" /></Border></Grid><Border Grid.Row="1" Name="CropDropZone" Background="#F8FAFC" BorderBrush="#DEE3E9" BorderThickness="1" CornerRadius="10" Padding="8" DragDrop.AllowDrop="True" DragDrop.DragOver="CropDropZone_DragOver" DragDrop.Drop="CropDropZone_Drop"><Grid RowDefinitions="28,*"><Grid ColumnDefinitions="*,150" Margin="8,0"><TextBlock Text="图片文件" FontSize="12" FontWeight="Bold" Foreground="#5D6C7B" /><TextBlock Grid.Column="1" Text="识别模式" FontSize="12" FontWeight="Bold" Foreground="#5D6C7B" /></Grid><ScrollViewer Grid.Row="1"><StackPanel Name="CropRows" Spacing="6" /></ScrollViewer></Grid></Border></Grid></Border><Grid Grid.Row="1" ColumnDefinitions="*,270"><Border Classes="card" Padding="12"><StackPanel Spacing="8"><TextBlock Text="裁切模式" FontSize="15" FontWeight="Bold" /><StackPanel Orientation="Horizontal" Spacing="8"><RadioButton Name="CropAuto" GroupName="CropMode" IsChecked="True" Checked="CropModeChanged">自动识别</RadioButton><RadioButton Name="CropRandom" GroupName="CropMode" Checked="CropModeChanged">四角乱切</RadioButton><RadioButton Name="CropGrid2" GroupName="CropMode" Checked="CropModeChanged">四宫格拆分</RadioButton><RadioButton Name="CropGrid3" GroupName="CropMode" Checked="CropModeChanged">九宫格拆分</RadioButton></StackPanel><Grid ColumnDefinitions="*,Auto"><StackPanel><TextBlock Text="快速模式" FontWeight="Bold" /><TextBlock Text="拖入图片后自动开始裁切" FontSize="11" Foreground="#8595A4" /></StackPanel><ToggleSwitch Grid.Column="1" Name="QuickCrop" /></Grid></StackPanel></Border><Border Grid.Column="1" Classes="card" Padding="12"><StackPanel Spacing="8"><TextBlock Text="保存设置" FontSize="15" FontWeight="Bold" /><Grid ColumnDefinitions="*,Auto"><TextBlock Text="自定义保存路径" FontWeight="Bold" VerticalAlignment="Center" /><ToggleSwitch Grid.Column="1" Name="UseCustomOutput" Checked="CustomOutputChanged" Unchecked="CustomOutputChanged" /></Grid><Grid ColumnDefinitions="*,110"><TextBox Name="OutputDirectory" IsEnabled="False" Watermark="（未选择保存路径）" /><Button Grid.Column="1" Name="BrowseOutput" Classes="secondary" IsEnabled="False" Click="BrowseOutputFolder">▱ 选择文件夹</Button></Grid><Button Classes="primary" Click="CropImages">▶  开始裁切</Button></StackPanel></Border></Grid></Grid>
          <Border Grid.Row="2" Classes="card" Padding="16"><Grid RowDefinitions="Auto,*"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="处理日志" FontSize="15" FontWeight="Bold" /><TextBlock Grid.Column="1" Text="最近记录" Foreground="#8595A4" FontSize="12" /></Grid><Border Grid.Row="1" Background="#F8FAFC" CornerRadius="10" Padding="12"><TextBox Name="CropLog" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" Background="Transparent" BorderThickness="0" FontSize="12" /></Border></Grid></Border>
        </Grid>
        <Grid Name="JdView" IsVisible="False" RowDefinitions="Auto,*,Auto" Margin="24">
          <Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="4"><TextBlock Text="京东详情页裁切" FontSize="24" FontWeight="Bold" Foreground="#0A1317" /><TextBlock Text="按顺序纵向拼接，统一 790 像素宽度，每 1500 像素切一张" FontSize="13" Foreground="#8595A4" /></StackPanel><Border Grid.Column="1" Background="#F1F4F8" CornerRadius="14" Padding="12,5"><StackPanel Orientation="Horizontal" Spacing="8"><Ellipse Width="8" Height="8" Fill="#31A24C" VerticalAlignment="Center" /><TextBlock Text="就绪" FontSize="12" FontWeight="Bold" /></StackPanel></Border></Grid>
          <Grid Grid.Row="1" ColumnDefinitions="*,396"><Border Classes="card" Padding="16"><Grid RowDefinitions="Auto,*,Auto"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="详情图片" FontSize="15" FontWeight="Bold" /><Border Grid.Column="1" Background="#EAF2FD" CornerRadius="12" Padding="10,4"><TextBlock Name="JdCount" Text="0 张待拼接" Foreground="#0064E0" FontSize="12" FontWeight="Bold" /></Border></Grid><Border Grid.Row="1" Name="JdDropZone" Background="#F8FAFC" BorderBrush="#DEE3E9" BorderThickness="1" CornerRadius="10" Padding="8" DragDrop.AllowDrop="True" DragDrop.DragOver="JdDropZone_DragOver" DragDrop.Drop="JdDropZone_Drop"><ScrollViewer><ListBox Name="JdList" SelectionMode="Multiple" Background="Transparent" BorderThickness="0" SelectionChanged="JdSelectionChanged" /></ScrollViewer></Border><Grid Grid.Row="2" ColumnDefinitions="80,80,*,124,124"><Button Classes="secondary" Click="MoveJdUp">↑ 上移</Button><Button Grid.Column="1" Classes="secondary" Click="MoveJdDown">↓ 下移</Button><Button Grid.Column="3" Classes="teal" Click="PreviewJd">◉ 拼接预览</Button><Button Grid.Column="4" Classes="primary" Click="ExportJd">⇩ 输出</Button></Grid></Grid></Border><Border Grid.Column="1" Classes="card" Padding="16"><Grid RowDefinitions="Auto,*"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="拼接预览" FontSize="15" FontWeight="Bold" /><Border Grid.Column="1" Background="#F1F4F8" CornerRadius="12" Padding="10,4"><TextBlock Name="ZoomLabel" Text="缩放 100%" FontSize="12" FontWeight="Bold" /></Border></Grid><Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#DEE3E9" BorderThickness="1" CornerRadius="12"><ScrollViewer><StackPanel Name="JdPreview" HorizontalAlignment="Center" Margin="20" Spacing="0"><Border Name="JdPlaceholder" Width="200" Height="380" CornerRadius="14" Background="#6786D9" /><TextBlock Name="JdPreviewHint" Text="拖入图片后点击「拼接预览」查看整体效果" Foreground="#5D6C7B" FontSize="13" Margin="0,16,0,0" TextAlignment="Center" /><TextBlock Text="支持鼠标滚轮滚动，按住 Ctrl 滚动缩放" Foreground="#8595A4" FontSize="11" Margin="0,8,0,0" TextAlignment="Center" /></StackPanel></ScrollViewer></Border></Grid></Border></Grid>
          <Border Grid.Row="2" Classes="card" Padding="16"><Grid RowDefinitions="Auto,*"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="处理日志" FontSize="15" FontWeight="Bold" /><TextBlock Grid.Column="1" Text="最近记录" Foreground="#8595A4" FontSize="12" /></Grid><Border Grid.Row="1" Background="#F8FAFC" CornerRadius="10" Padding="12"><TextBox Name="JdLog" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" Background="Transparent" BorderThickness="0" FontSize="12" /></Border></Grid></Border>
        </Grid>
      </Grid>
    </Grid>
</Window>
